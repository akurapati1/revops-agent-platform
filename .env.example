# ---- Core ----
APP_ENV=development                 # development | test | production
DATABASE_URL=postgresql+asyncpg://revops:revops@localhost:5432/revops   # sqlite+aiosqlite:///./revops.db for zero-setup dev
REDIS_URL=                          # optional: enables Redis job queue + shared rate limiting (needs the worker process)
AUTO_CREATE_TABLES=true             # dev convenience; set false in production and use `alembic upgrade head`
LOG_LEVEL=INFO

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string     # REQUIRED in production (openssl rand -hex 32)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000             # used to build OAuth redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- LLM ----
LLM_PROVIDER=mock                   # mock (offline, deterministic) | openrouter
OPENROUTER_API_KEY=                 # required when LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_DEFAULT=openai/gpt-4o-mini
MODEL_RESEARCHER=
MODEL_ENRICHER=
MODEL_PERSONALIZER=anthropic/claude-3.5-haiku
MODEL_TRIAGE=
DEFAULT_MONTHLY_TOKEN_LIMIT=500000 # per-org default, editable in Settings
ENABLE_WEB_TOOLS=false              # let the Researcher fetch the lead's homepage (SSRF-guarded)

# ---- Email ----
EMAIL_PROVIDER=console              # console (log only) | smtp
EMAIL_FROM=RevOps Agent <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- Limits / runtime ----
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
RUN_SCHEDULER=true                  # in-process scheduler for delayed sequence steps (no-Redis mode)

# ---- Frontend (build time) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
